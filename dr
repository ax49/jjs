-- quiet: swallow per-frame errors so the log stays readable
local function safe(fn) pcall(fn) end

-- ===================== HELPERS =====================
local function isPlayerChar(model)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character == model then return true end
    end
    return false
end
local function myRoot()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function inputName(input)
    local kc = input.KeyCode
    if kc then local ok, n = pcall(function() return kc.Name end) if ok and n and n ~= "Unknown" then return n end end
    local uit = input.UserInputType
    if uit then local ok, n = pcall(function() return uit.Name end) if ok and n then return n end end
    return nil
end

local function typeOf(name)
    if name:find("Zombie") or name:find("Runner") or name:find("Walker") then return "zombie"
    elseif name:find("Turret") then return "turret" else return "soldier" end
end
local function typeEnabled(t)
    if t == "zombie" then return S.ShowZombies
    elseif t == "turret" then return S.ShowTurrets else return S.ShowSoldiers end
end
local function isHostile(m)
    if not (m and m:IsA("Model")) then return false end
    if m == LP.Character or isPlayerChar(m) then return false end
    if not m.Name:match("^Model_") then return false end
    local h = m:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end
local function getHostiles()
    local out = {}
    for _, m in ipairs(Workspace:GetDescendants()) do
        if isHostile(m) then table.insert(out, m) end
    end
    return out
end
local function rootDist(m)
    local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
    local mr = myRoot()
    if not (r and mr) then return math.huge end
    return (r.Position - mr.Position).Magnitude
end

-- ===================== ENEMY ESP =====================
local espCache = {}
local function colorFor(t)
    if t == "zombie" then return Color3.fromRGB(120,230,90)
    elseif t == "turret" then return Color3.fromRGB(255,170,40)
    else return Color3.fromRGB(255,60,60) end
end
local function makeESP(model, t)
    if espCache[model] then return end
    local c = colorFor(t)

    -- body outline: try Highlight, fall back to SelectionBox, else billboard only
    local outline
    local okH = pcall(function()
        local hl = Instance.new("Highlight")
        hl.FillColor, hl.OutlineColor, hl.FillTransparency = c, Color3.new(1,1,1), 0.6
        hl.Adornee, hl.Parent = model, model
        outline = hl
    end)
    if not okH then
        pcall(function()
            local adornee = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
            local sb = Instance.new("SelectionBox")
            sb.Color3 = c
            sb.LineThickness = 0.05
            sb.SurfaceTransparency = 0.7
            sb.SurfaceColor3 = c
            sb.Adornee = adornee
            sb.Parent = adornee or model
            outline = sb
        end)
    end

    local anchor = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    local bb = Instance.new("BillboardGui")
    bb.Size, bb.StudsOffset, bb.AlwaysOnTop = UDim2.new(0,150,0,34), Vector3.new(0,3.2,0), true
    bb.Adornee, bb.Parent = anchor, model
    local lbl = Instance.new("TextLabel")
    lbl.Size, lbl.BackgroundTransparency = UDim2.new(1,0,0,18), 1
    lbl.TextColor3, lbl.TextStrokeTransparency = c, 0
    lbl.Font, lbl.TextSize = Enum.Font.GothamBold, 13
    lbl.Parent = bb
    local barBack = Instance.new("Frame")
    barBack.Size, barBack.Position = UDim2.new(0.7,0,0,5), UDim2.new(0.15,0,0,22)
    barBack.BackgroundColor3, barBack.BorderSizePixel = Color3.fromRGB(35,35,40), 0
    barBack.Parent = bb
    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(1,0,1,0)
    barFill.BackgroundColor3, barFill.BorderSizePixel = Color3.fromRGB(90,220,90), 0
    barFill.Parent = barBack

    espCache[model] = {hl=outline, bb=bb, lbl=lbl, bar=barFill, barBack=barBack}
end
local function clearESP(m)
    local e = espCache[m]
    if e then
        if e.hl then pcall(function() e.hl:Destroy() end) end
        if e.bb then pcall(function() e.bb:Destroy() end) end
        espCache[m] = nil
    end
end
local function clearAllESP() for m in pairs(espCache) do clearESP(m) end end
local function pretty(name) return (name:gsub("^Model_",""):gsub("(%l)(%u)","%1 %2")) end

-- ===================== ITEM ESP =====================
local itemCache = {}
local function itemCategory(name)
    name = name:lower()
    for cat, list in pairs(ItemCategories) do
        for _, key in ipairs(list) do if name:find(key,1,true) then return cat end end
    end
end
local function catEnabled(cat)
    if cat == "weapon" then return S.ShowWeapons
    elseif cat == "ammo" then return S.ShowAmmo
    elseif cat == "healing" then return S.ShowHealing
    elseif cat == "valuable" then return S.ShowValuables end
    return false
end
local function itemColor(cat)
    if cat == "weapon" then return Color3.fromRGB(200,200,255)
    elseif cat == "ammo" then return Color3.fromRGB(255,200,120)
    elseif cat == "healing" then return Color3.fromRGB(120,255,180)
    else return Color3.fromRGB(255,235,120) end
end
local function makeItemESP(o, cat)
    if itemCache[o] then return end
    local part = o:IsA("BasePart") and o or o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart", true)
    if not part then return end
    local bb = Instance.new("BillboardGui")
    bb.Size, bb.StudsOffset, bb.AlwaysOnTop = UDim2.new(0,120,0,18), Vector3.new(0,2,0), true
    bb.Adornee, bb.Parent = part, part
    local lbl = Instance.new("TextLabel")
    lbl.Size, lbl.BackgroundTransparency = UDim2.new(1,0,1,0), 1
    lbl.TextColor3, lbl.TextStrokeTransparency = itemColor(cat), 0
    lbl.Font, lbl.TextSize, lbl.Text = Enum.Font.GothamBold, 12, o.Name:gsub("_"," ")
    lbl.Parent = bb
    itemCache[o] = bb
end
local function clearItemESP(o) if itemCache[o] then pcall(function() itemCache[o]:Destroy() end) itemCache[o]=nil end end
local function clearAllItemESP() for o in pairs(itemCache) do clearItemESP(o) end end

-- ===================== AIMBOT =====================
local function closestTarget()
    if not Camera then return nil end
    local vp = Camera.ViewportSize
    if not vp then return nil end
    local center = Vector2.new(vp.X/2, vp.Y/2)
    local best, bestScore = nil, math.huge
    for _, m in ipairs(getHostiles()) do
        if typeEnabled(typeOf(m.Name)) then
            local part = m:FindFirstChild(S.AimPart) or m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if part and rootDist(m) <= S.MaxAimDist then
                local sp, on = Camera:WorldToViewportPoint(part.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d < bestScore then bestScore, best = d, part end
                end
            end
        end
    end
    return best
end
local aiming = false
local function aimMatches(input)
    local n = inputName(input)
    return n ~= nil and n == S.AimKeyName
end
UIS.InputBegan:Connect(function(i, gpe) if not gpe and aimMatches(i) then aiming = true end end)
UIS.InputEnded:Connect(function(i) if aimMatches(i) then aiming = false end end)

-- ===================== LIGHTING / CAMERA =====================
local saved = {fe=Lighting.FogEnd, fs=Lighting.FogStart, b=Lighting.Brightness, ct=Lighting.ClockTime}
local function applyLighting()
    safe(function()
        if S.NoFog then Lighting.FogEnd, Lighting.FogStart = 1e9, 1e9
        else Lighting.FogEnd, Lighting.FogStart = saved.fe, saved.fs end
        if S.FullBright then Lighting.Brightness, Lighting.ClockTime = 3, 14
        else Lighting.Brightness, Lighting.ClockTime = saved.b, saved.ct end
    end)
end
local function applyCameraMode()
    safe(function()
        if S.ThirdPerson then
            LP.CameraMode = Enum.CameraMode.Classic
            LP.CameraMaxZoomDistance = 128
            LP.CameraMinZoomDistance = 0.5
        else
            LP.CameraMode = Enum.CameraMode.LockFirstPerson
        end
    end)
end

-- ===================== MAIN LOOP =====================
local hostileCount = 0
RunService.RenderStepped:Connect(function()
    safe(function()
        if S.ESP then
            local live, count = {}, 0
            for _, m in ipairs(getHostiles()) do
                count = count + 1
                local t = typeOf(m.Name)
                local dist = rootDist(m)
                if typeEnabled(t) and dist <= S.ESPDistance then
                    live[m] = true
                    makeESP(m, t)
                    local e = espCache[m]
                    if e and e.lbl then
                        local hum = m:FindFirstChildOfClass("Humanoid")
                        local hp = hum and hum.Health or 0
                        local maxhp = hum and hum.MaxHealth or 100
                        if maxhp <= 0 then maxhp = 100 end
                        local ratio = math.clamp(hp / maxhp, 0, 1)
                        e.lbl.Text = string.format("%s [%dm]", pretty(m.Name), math.floor(dist))
                        e.barBack.Visible = S.HealthBars
                        e.bar.Visible = S.HealthBars
                        if S.HealthBars and e.bar then
                            e.bar.Size = UDim2.new(ratio, 0, 1, 0)
                            e.bar.BackgroundColor3 = Color3.fromRGB(
                                math.floor(220*(1-ratio) + 90*ratio),
                                math.floor(90*(1-ratio) + 220*ratio), 90)
                        end
                    end
                end
            end
            hostileCount = count
            for m in pairs(espCache) do if not live[m] or not m.Parent then clearESP(m) end end
        else clearAllESP() end

        if S.ItemESP then
            local container = Workspace:FindFirstChild("ObjectModels")
            local live = {}
            if container then
                for _, o in ipairs(container:GetChildren()) do
                    local cat = itemCategory(o.Name)
                    if cat and catEnabled(cat) then live[o] = true makeItemESP(o, cat) end
                end
            end
            for o in pairs(itemCache) do if not live[o] or not o.Parent then clearItemESP(o) end end
        else clearAllItemESP() end

        if S.Aimbot and aiming and Camera then
            local target = closestTarget()
            if target then
                local sm = math.clamp((S.Smoothness or 0) / 100, 0, 1)
                local goal = CFrame.new(Camera.CFrame.Position, target.Position)
                Camera.CFrame = sm <= 0 and goal or Camera.CFrame:Lerp(goal, 1 - sm)
            end
        end
    end)
end)

