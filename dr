local function Slider(page, label, key, min, max, suffix)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -8, 0, 36)
    holder.BackgroundColor3 = PALETTE.surface2
    holder.BorderSizePixel = 0
    holder.Parent = page
    corner(holder, 5)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -16, 0, 16)
    lbl.Position = UDim2.new(0, 8, 0, 2)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = PALETTE.text
    lbl.Font, lbl.TextSize = Enum.Font.Gotham, 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = holder
    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -16, 0, 6)
    track.Position = UDim2.new(0, 8, 0, 24)
    track.BackgroundColor3 = PALETTE.track
    track.BorderSizePixel = 0
    track.Parent = holder
    corner(track, 3)
    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = PALETTE.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 3)
    local function setA(a)
        a = math.clamp(a, 0, 1)
        fill.Size = UDim2.new(a, 0, 1, 0)
        S[key] = math.floor(min + (max - min) * a)
        lbl.Text = string.format("%s: %d%s", label, S[key], suffix or "")
    end
    setA((S[key] - min) / (max - min))
    local drag = false
    track.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
    UIS.InputChanged:Connect(function(i)
        if drag and i.UserInputType == Enum.UserInputType.MouseMovement then
            setA((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X)
        end
    end)
end

local function Keybind(page, label, key)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -8, 0, 26)
    btn.BackgroundColor3 = PALETTE.surface2
    btn.AutoButtonColor = false
    btn.TextColor3 = PALETTE.text
    btn.Font, btn.TextSize = Enum.Font.Gotham, 12
    btn.Text = label .. ": " .. tostring(S[key])
    btn.Parent = page
    corner(btn, 5)
    btn.MouseButton1Click:Connect(function()
        btn.Text = label .. ": press..."
        local conn
        conn = UIS.InputBegan:Connect(function(input)
            local n = inputName(input)
            if n then S[key] = n btn.Text = label .. ": " .. n conn:Disconnect() end
        end)
    end)
end

