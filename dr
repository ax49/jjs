local tabs = {}
local activeTab = nil
local tabButtonY = 6

local function selectTab(name)
    activeTab = name
    for n, t in pairs(tabs) do
        t.page.Visible = (n == name)
        t.button.BackgroundColor3 = (n == name) and PALETTE.accent or PALETTE.surface
        t.button.TextColor3 = (n == name) and Color3.new(0,0,0) or PALETTE.text
    end
end

local function Tab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -8, 0, 28)
    btn.Position = UDim2.new(0, 4, 0, tabButtonY)
    btn.BackgroundColor3 = PALETTE.surface
    btn.TextColor3 = PALETTE.text
    btn.Font, btn.TextSize = Enum.Font.GothamMedium, 12
    btn.Text = name
    btn.AutoButtonColor = false
    btn.Parent = rail
    corner(btn, 5)
    tabButtonY = tabButtonY + 32

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 4
    page.CanvasSize = UDim2.new(0,0,0,0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = content
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = page

    tabs[name] = {page = page, button = btn}
    btn.MouseButton1Click:Connect(function() selectTab(name) end)
    if not activeTab then selectTab(name) end
    return page
end

